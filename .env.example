# ─────────────────────────────────────────────
# SecureRAG-Health — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag_app_user:apppass@localhost:5432/securerag
DATABASE_SYNC_URL=postgresql+psycopg2://rag_app_user:apppass@localhost:5432/securerag
DB_APP_USER=rag_app_user
DB_APP_PASSWORD=apppass

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securerag

# ── SpiceDB ──────────────────────────────────
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_PRESHARED_KEY=dev-secret-key

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenAI LLM ───────────────────────────────
OPENAI_API_KEY=sk-YOUR_KEY_HERE
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=1500

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Embeddings & RAG ─────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_CHUNKS=10
